# =============================================================================
# App Connections — environment variables reference
# Social Media Hub
#
# App Connections stores Meta App Id, App Secret, Callback URL, and Scopes
# in the DATABASE (via the UI). No new Meta credential env vars are required.
# =============================================================================


# =============================================================================
# BACKEND (Railway / Docker / appsettings / .env)
# =============================================================================

# --- Required (unchanged — same as before App Connections) -------------------

# Postgres connection (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Or individual PG vars:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-password
# PGDATABASE=social_media_hub
# PGSSLMODE=Prefer

# JWT (required for OAuth state signing)
# JwtSettings__SecretKey=your-long-secret-key-min-32-chars
# JwtSettings__Issuer=SocialMediaHub
# JwtSettings__Audience=SocialMediaHubClients

# CORS — frontend origin must be allowed for OAuth popup postMessage
# corsOrigins=https://your-frontend.up.railway.app,http://localhost:4200
# frontendBaseUrl=https://your-frontend.up.railway.app

# --- Run database migration on startup (recommended once after deploy) ---------
SEED_ON_STARTUP=true

# --- Integrations only (NOT used by App Connections OAuth) -------------------
# App Connections credentials are entered in the App Connections UI and saved
# to MetaAppConnections table. These remain for the Integrations menu only:

# facebookAppId=YOUR_FACEBOOK_APP_ID
# facebookAppSecret=YOUR_FACEBOOK_APP_SECRET
# instagramAppId=YOUR_INSTAGRAM_APP_ID
# instagramAppSecret=YOUR_INSTAGRAM_APP_SECRET
# instagramLoginAppId=YOUR_INSTAGRAM_LOGIN_APP_ID
# instagramLoginAppSecret=YOUR_INSTAGRAM_LOGIN_APP_SECRET
# whatsappAppId=YOUR_WHATSAPP_APP_ID
# whatsappAppSecret=YOUR_WHATSAPP_APP_SECRET
# metaRedirectUri=https://YOUR-BACKEND.up.railway.app/api/Integrations/Callback

# --- App Connections callback (register in Meta Developer Console) -----------
# NOT an env var — register this URL in each Meta app's Valid OAuth Redirect URIs:
#
#   https://YOUR-BACKEND.up.railway.app/api/AppConnections/Callback
#
# Example production:
#   https://socialbackend-production-a9ea.up.railway.app/api/AppConnections/Callback
#
# Local dev example:
#   http://localhost:5080/api/AppConnections/Callback


# =============================================================================
# FRONTEND (Railway build env / .env — used by scripts/set-env.js)
# =============================================================================

# --- Required (unchanged — no NEW variables for App Connections) --------------

# Backend API base URL (also used to pre-fill App Connections callback URL)
API_URL=https://YOUR-BACKEND.up.railway.app/api

# SignalR inbox hub (optional — derived from API_URL if omitted)
HUB_URL=https://YOUR-BACKEND.up.railway.app/hubs/inbox

# --- Integrations UI hints only (NOT used by App Connections) -----------------
# These show "configured?" hints on the Integrations screen only.

META_FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
META_INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID
META_INSTAGRAM_LOGIN_APP_ID=YOUR_INSTAGRAM_LOGIN_APP_ID
META_WHATSAPP_APP_ID=YOUR_WHATSAPP_APP_ID

# --- App Connections frontend note -------------------------------------------
# Default callback URL in the form is computed as:
#   ${API_URL}/AppConnections/Callback
# No separate frontend env var is needed.


# =============================================================================
# META DEVELOPER CONSOLE (per app you add in App Connections UI)
# =============================================================================
#
# For EACH Meta developer app used in App Connections:
#
# 1. App Dashboard → Facebook Login / Instagram / WhatsApp → Settings
# 2. Valid OAuth Redirect URIs → add:
#      https://YOUR-BACKEND/api/AppConnections/Callback
# 3. Copy App Id and App Secret into App Connections → Add app connection
# 4. Scopes are configured per app in the UI (or use App Connections defaults)
#
# Integrations and App Connections use DIFFERENT callback paths:
#   Integrations:    /api/Integrations/Callback
#   App Connections: /api/AppConnections/Callback
# =============================================================================
